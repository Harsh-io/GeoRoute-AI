# GeoRoute AI — Environment Variables Example
# Duplicate this file to .env and configure for your local or production deployment.
# DO NOT commit real API keys, passwords, or private tokens to Git.

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
GEOROUTE_ENV=production
GEOROUTE_HOST=0.0.0.0
GEOROUTE_PORT=8000
GEOROUTE_CORS_ORIGINS=https://georoute-ai.vercel.app,http://localhost:5173

# Directory and Database Storage Paths
GEOROUTE_DATA_DIR=data
GEOROUTE_COST_DIR=data/cost
GEOROUTE_REGIONAL_COST_DIR=data/cost/regional
GEOROUTE_JOBS_DIR=data/jobs
GEOROUTE_DB_PATH=data/jobs/georoute_jobs.db

# Concurrency & Worker Limits
GEOROUTE_MAX_ACTIVE_JOBS=2
GEOROUTE_MAX_QUEUED_JOBS=10
GEOROUTE_JOB_TIMEOUT=600.0

# ==========================================
# Frontend Configuration (React / Vite)
# ==========================================
VITE_API_BASE_URL=https://georoute-ai-api.onrender.com/api/v1
VITE_CARTO_API_KEY=your_carto_api_key_here
