class AlignedRasterData:
    data: np.ndarray        # Shape (bands, height, width) — the actual pixel values
    transform: Affine       # Affine georeferencing matrix
    crs: pyproj.CRS         # Coordinate reference system
    nodata: Optional[float] # Value representing "no data" (0.0 for optical, -9999.0 for DEM)
