    # Step B: Compute the master 10m pixel grid
    self.target_transform, self.grid_width, self.grid_height, self.snapped_bounds = \
        compute_target_raster_grid(
            bbox_4326=self.config.bbox.as_tuple,
            target_crs=self.target_utm_crs,
            pixel_size_meters=self.config.processing.target_pixel_size_meters,
        )

    # Step C: Instantiate all sub-modules (no I/O yet — just configuration)
    self.vector_ingestor = OSMVectorIngestor(...)
    self.stac_ingestor = STACRasterIngestor(...)
    self.aligner = SpatialAligner(target_crs=self.target_utm_crs, target_transform=self.target_transform, ...)
