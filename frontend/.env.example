# GeoRoute AI Frontend — Environment Variables Example
# Set these in your Vercel project environment configuration

# Production API Endpoint (pointing to deployed FastAPI backend /api/v1)
VITE_API_BASE_URL=https://georoute-ai-api.onrender.com/api/v1

# CARTO Basemap API Key for MapLibre GL
VITE_CARTO_API_KEY=your_carto_api_key_here
